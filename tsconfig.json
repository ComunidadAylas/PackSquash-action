{
  "compilerOptions": {
    "target": "es2021",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": [
      // We target a non-browser environment, so only ECMAScript and Node APIs
      // are available.
      "ESNext"
    ]
  }
}
